<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="estate_property_action" model="ir.actions.act_window">
    <field name="name">Estate Property</field>
    <field name="res_model">estate.property</field>
    <field name="view_mode">list,form</field>
    </record>


    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Properties">
                <field name="name"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="date_availability"/>
            
            </list>
        
        </field>

    </record>

    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Propertie">
                <sheet>
                    <h1>
                        <field name="name"/>
                    </h1>
                    <header>
                        <button name="action_cancel" type="object" string="Cancel" invisible="state == 'sold'" />
                        <button name="action_sold" type="object" string="Sold" invisible="state == 'cancelled'" />
                          <field name="state" widget="statusbar" />
                    </header>
                    <group>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    </group>
                    <group>
                        <group>
                            <field name="property_type_id" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="postcode"/>
                        </group>
                        <group>
                            <field name="best_price" string="Best Offer"/>
                        </group>
                        <group>
                            <!-- Add a dropdown to allow manual state changes -->
                            <field name="state" widget="selection"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="date_availability" string="Available From"/>
                        </group>
                        <group>
                            <field name="selling_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description"/>
                            </group>
                            <group>
                                <field name="bedrooms"/>
                            </group>
                            <group>
                                <field name="living_area" string="Living Area (sqm)"/>
                            </group>
                            <group>
                                <field name="facades"/>
                            </group>
                            <group>
                                <field name="garage"/>
                            </group>
                            <group>
                                <field name="garden"/>
                            </group>
                            <group>
                                <field name="garden_area" string="Garden Area (sqm)" invisible="not garden"/>
                            </group>
                            <group>
                                <field name="garden_orientation" invisible="not garden"/>
                            </group>
                            <group>
                                <field name="total_area" string="Total Area (sqm)" />
                            </group>
                        </page>
                        <page string="Offers">
                                <field name="offer_ids" readonly="state in ('offer_accepted', 'sold', 'cancelled')">
                                    <list string="Offers">
                                        <field name="price"/>
                                        <field name="partner_id"/>
                                        <field name="status"/>
                                        <button name="action_accept" type="object" string="Accept" icon="fa-check" invisible="state== true"/>
                                        <button name="action_refuse" type="object" string="Refuse" invisible="state== true" />
                                        <field name="validity"/>
                                        <field name="date_deadline"/>
                                    </list>
                                    <form string="Create Offers">
                                        <group>
                                            <field name="price"/>
                                        </group>
                                        <group>
                                            <field name="partner_id"/>
                                        </group>
                                        <group>
                                            <field name="validity" string="Validity (days)"/>
                                        </group>
                                        <group>
                                            <field name="date_deadline" string="Deadline"/>
                                        </group>
                                        <group>
                                            <field name="status"/>
                                        </group>
                                        
                                    </form>
                                   
                                </field>
                                
                        </page>
                        <page string="Other Info">
                            <group>
                            <field name="user_id"/>
                            </group>
                            <group>
                            <field name="partner_id"/>
                            </group>
                        </page>
                    </notebook>

                </sheet>
            
            </form>
        
        </field>

    </record>

    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Recherche des propriétés">
                <field name="name"/>
                <field name="bedrooms"/>
                <separator/>

                <filter string="Actives"  name ="actif" domain="[('active', '=', True)]"/>
                <filter string="Inactives" name = "desactif" domain="[('active', '=', False)]"/>

                <group expand="1" string="Filtres avancés">
                    <filter string="3 chambres et plus" name="chambre" domain="[('bedrooms', '>=', 3)]"/>
                    <filter string="Prix abordable" name="prix" domain="[('selling_price', '&lt;=', 100000)]"/>
                </group>
                
            </search>
        </field>
    </record>



 </odoo>